{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xfeeds-browser-canary",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "limits": {
    "cpu_ms": 500
  },
  "vars": {
    "DEPLOY_MODE": "scheduled-daily-et",
    "MAX_HANDLES_PER_RUN": "1",
    "MAX_POSTS_PER_HANDLE": "10",
    "RUN_DEADLINE_MS": "45000",
    "SCHEDULED_RUN_DEADLINE_MS": "300000",
    "SCHEDULE_TIME_ZONE": "America/New_York",
    "SCHEDULE_HOURS": "7,9,11,13,15,17,19"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_STATE"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xfeeds-browser-canary",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
